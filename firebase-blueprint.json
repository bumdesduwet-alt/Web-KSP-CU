{
  "entities": {
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Konfigurasi beranda, identitas resmi, kontak WhatsApp, media sosial, dan statistik koperasi.",
      "type": "object",
      "properties": {
        "cooperativeName": { "type": "string", "minLength": 3, "maxLength": 120 },
        "tagline": { "type": "string", "minLength": 5, "maxLength": 220 },
        "welcomeTitle": { "type": "string", "minLength": 5, "maxLength": 180 },
        "welcomeMessage": { "type": "string", "minLength": 10, "maxLength": 1500 },
        "heroImageUrl": { "type": "string", "maxLength": 250000 },
        "importantAnnouncement": { "type": "string", "maxLength": 500 },
        "showAnnouncement": { "type": "boolean" },
        "address": { "type": "string", "minLength": 5, "maxLength": 300 },
        "whatsappNumber": { "type": "string", "minLength": 8, "maxLength": 25, "pattern": "^[0-9+\\-\\s]+$" },
        "email": { "type": "string", "maxLength": 120 },
        "serviceHours": { "type": "string", "maxLength": 220 },
        "socialLinks": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string", "maxLength": 300 },
            "facebook": { "type": "string", "maxLength": 300 },
            "youtube": { "type": "string", "maxLength": 300 }
          }
        },
        "stats": {
          "type": "array",
          "description": "Maksimal 6 statistik perkembangan koperasi."
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "cooperativeName",
        "tagline",
        "welcomeTitle",
        "welcomeMessage",
        "heroImageUrl",
        "importantAnnouncement",
        "showAnnouncement",
        "address",
        "whatsappNumber",
        "email",
        "serviceHours",
        "socialLinks",
        "stats",
        "updatedAt"
      ]
    },
    "CooperativeProfile": {
      "title": "CooperativeProfile",
      "description": "Profil resmi, sejarah, visi misi, nilai, prinsip, struktur organisasi, dan pengurus/pengawas.",
      "type": "object",
      "properties": {
        "history": { "type": "string", "minLength": 10, "maxLength": 6000 },
        "vision": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "missions": { "type": "array" },
        "values": { "type": "array" },
        "principles": { "type": "array" },
        "objectives": { "type": "array" },
        "orgStructureSummary": { "type": "string", "maxLength": 2000 },
        "officePhotos": { "type": "array" },
        "boardMembers": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "history",
        "vision",
        "missions",
        "values",
        "principles",
        "objectives",
        "orgStructureSummary",
        "officePhotos",
        "boardMembers",
        "updatedAt"
      ]
    },
    "JoinGuide": {
      "title": "JoinGuide",
      "description": "Informasi cara bergabung menjadi anggota koperasi.",
      "type": "object",
      "properties": {
        "benefits": { "type": "array" },
        "requirements": { "type": "array" },
        "steps": { "type": "array" },
        "documents": { "type": "array" },
        "contactPersonName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "contactPersonRole": { "type": "string", "minLength": 2, "maxLength": 120 },
        "contactWhatsapp": { "type": "string", "minLength": 8, "maxLength": 25, "pattern": "^[0-9+\\-\\s]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "benefits",
        "requirements",
        "steps",
        "documents",
        "contactPersonName",
        "contactPersonRole",
        "contactWhatsapp",
        "updatedAt"
      ]
    },
    "CooperativeProduct": {
      "title": "CooperativeProduct",
      "description": "Produk resmi simpanan dan pinjaman koperasi.",
      "type": "object",
      "properties": {
        "category": { "type": "string", "enum": ["simpanan", "pinjaman"] },
        "subType": { "type": "string", "minLength": 2, "maxLength": 80 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "imageUrl": { "type": "string", "maxLength": 250000 },
        "description": { "type": "string", "minLength": 5, "maxLength": 2500 },
        "requirements": { "type": "string", "maxLength": 2000 },
        "terms": { "type": "string", "maxLength": 2000 },
        "benefits": { "type": "string", "maxLength": 2000 },
        "isPublished": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "category",
        "subType",
        "name",
        "imageUrl",
        "description",
        "requirements",
        "terms",
        "benefits",
        "isPublished",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "MemberCategory": {
      "title": "MemberCategory",
      "description": "Kategori produk usaha anggota.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "slug": { "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[a-z0-9\\-]+$" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "sortOrder", "createdAt"]
    },
    "MemberProduct": {
      "title": "MemberProduct",
      "description": "Produk UMKM milik anggota koperasi yang dipromosikan di marketplace.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "price": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "imageUrl": { "type": "string", "maxLength": 250000 },
        "ownerName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "businessName": { "type": "string", "maxLength": 140 },
        "description": { "type": "string", "minLength": 5, "maxLength": 2500 },
        "location": { "type": "string", "minLength": 2, "maxLength": 160 },
        "whatsappNumber": { "type": "string", "minLength": 8, "maxLength": 25, "pattern": "^[0-9+\\-\\s]+$" },
        "isFeatured": { "type": "boolean" },
        "status": { "type": "string", "enum": ["approved", "pending", "hidden"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "category",
        "price",
        "unit",
        "imageUrl",
        "ownerName",
        "businessName",
        "description",
        "location",
        "whatsappNumber",
        "isFeatured",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "MemberProductSubmission": {
      "title": "MemberProductSubmission",
      "description": "Formulir pendaftaran produk anggota sebelum ditinjau administrator.",
      "type": "object",
      "properties": {
        "ownerName": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[^<>]+$" },
        "businessName": { "type": "string", "maxLength": 140, "pattern": "^[^<>]*$" },
        "productName": { "type": "string", "minLength": 2, "maxLength": 140, "pattern": "^[^<>]+$" },
        "category": { "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[^<>]+$" },
        "price": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^<>]+$" },
        "description": { "type": "string", "minLength": 10, "maxLength": 2000, "pattern": "^[^<>]+$" },
        "location": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[^<>]+$" },
        "whatsappNumber": { "type": "string", "minLength": 8, "maxLength": 25, "pattern": "^[0-9+\\-\\s]+$" },
        "imageUrl": { "type": "string", "maxLength": 250000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerName",
        "businessName",
        "productName",
        "category",
        "price",
        "unit",
        "description",
        "location",
        "whatsappNumber",
        "imageUrl",
        "status",
        "createdAt"
      ]
    },
    "NewsArticle": {
      "title": "NewsArticle",
      "description": "Artikel berita, pengumuman, dan informasi resmi koperasi.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 5, "maxLength": 200 },
        "slug": { "type": "string", "minLength": 3, "maxLength": 200, "pattern": "^[a-z0-9\\-]+$" },
        "category": {
          "type": "string",
          "enum": [
            "Berita Koperasi",
            "Pengumuman",
            "Kegiatan Anggota",
            "Pendidikan dan Pelatihan",
            "Informasi Usaha",
            "Informasi Lainnya"
          ]
        },
        "coverImageUrl": { "type": "string", "maxLength": 250000 },
        "author": { "type": "string", "minLength": 2, "maxLength": 120 },
        "excerpt": { "type": "string", "minLength": 5, "maxLength": 450 },
        "content": { "type": "string", "minLength": 10, "maxLength": 15000 },
        "supportingImages": { "type": "array" },
        "isPublished": { "type": "boolean" },
        "isImportant": { "type": "boolean" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "slug",
        "category",
        "coverImageUrl",
        "author",
        "excerpt",
        "content",
        "supportingImages",
        "isPublished",
        "isImportant",
        "publishedAt",
        "updatedAt"
      ]
    },
    "NewsComment": {
      "title": "NewsComment",
      "description": "Komentar pengunjung dan balasan resmi pengurus pada berita.",
      "type": "object",
      "properties": {
        "articleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 100, "pattern": "^[^<>]+$" },
        "content": { "type": "string", "minLength": 3, "maxLength": 1000, "pattern": "^[^<>]+$" },
        "status": { "type": "string", "enum": ["pending", "approved", "hidden"] },
        "boardReply": { "type": "string", "maxLength": 1500 },
        "boardReplyAuthor": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "articleId",
        "authorName",
        "content",
        "status",
        "boardReply",
        "boardReplyAuthor",
        "createdAt",
        "updatedAt"
      ]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Dokumentasi foto dan video kegiatan koperasi.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["photo", "video"] },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "caption": { "type": "string", "maxLength": 600 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "activityDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "mediaUrl": { "type": "string", "minLength": 5, "maxLength": 650000 },
        "thumbnailUrl": { "type": "string", "maxLength": 250000 },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "type",
        "title",
        "caption",
        "category",
        "activityDate",
        "mediaUrl",
        "thumbnailUrl",
        "isPublished",
        "createdAt"
      ]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Testimoni anggota koperasi.",
      "type": "object",
      "properties": {
        "memberName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "memberRole": { "type": "string", "minLength": 2, "maxLength": 120 },
        "quote": { "type": "string", "minLength": 10, "maxLength": 600 },
        "isPublished": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["memberName", "memberRole", "quote", "isPublished", "sortOrder", "createdAt"]
    },
    "JoinInquiry": {
      "title": "JoinInquiry",
      "description": "Data minat bergabung calon anggota koperasi (privat admin).",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[^<>]+$" },
        "phone": { "type": "string", "minLength": 8, "maxLength": 25, "pattern": "^[0-9+\\-\\s]+$" },
        "address": { "type": "string", "minLength": 5, "maxLength": 300, "pattern": "^[^<>]+$" },
        "message": { "type": "string", "maxLength": 1500, "pattern": "^[^<>]*$" },
        "status": { "type": "string", "enum": ["baru", "dihubungi", "selesai"] },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "phone", "address", "message", "status", "adminNotes", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Pesan masuk dari halaman Hubungi Kami (privat admin).",
      "type": "object",
      "properties": {
        "senderName": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[^<>]+$" },
        "senderContact": { "type": "string", "minLength": 4, "maxLength": 120, "pattern": "^[^<>]+$" },
        "subject": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[^<>]+$" },
        "message": { "type": "string", "minLength": 5, "maxLength": 2000, "pattern": "^[^<>]+$" },
        "status": { "type": "string", "enum": ["baru", "dibaca", "dibalas"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderName", "senderContact", "subject", "message", "status", "createdAt"]
    },
    "VisitLog": {
      "title": "VisitLog",
      "description": "Log aktivitas kunjungan halaman publik tanpa data pribadi untuk statistik admin.",
      "type": "object",
      "properties": {
        "page": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^/[a-z0-9\\-/]*$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["page", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Daftar pengguna administrator terverifikasi.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 5, "maxLength": 150 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "super_admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "displayName", "role", "createdAt"]
    }
  },
  "firestore": {
    "/siteSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Konfigurasi beranda dan kontak resmi koperasi."
    },
    "/cooperativeProfile/{profileId}": {
      "schema": { "$ref": "#/entities/CooperativeProfile" },
      "description": "Profil resmi, sejarah, visi misi, dan susunan pengurus."
    },
    "/joinGuide/{guideId}": {
      "schema": { "$ref": "#/entities/JoinGuide" },
      "description": "Panduan dan persyaratan cara bergabung menjadi anggota."
    },
    "/cooperativeProducts/{productId}": {
      "schema": { "$ref": "#/entities/CooperativeProduct" },
      "description": "Katalog produk simpanan dan pinjaman koperasi."
    },
    "/memberCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/MemberCategory" },
      "description": "Kategori marketplace produk UMKM anggota."
    },
    "/memberProducts/{productId}": {
      "schema": { "$ref": "#/entities/MemberProduct" },
      "description": "Daftar produk UMKM anggota yang disetujui untuk tampil publik."
    },
    "/memberProductSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/MemberProductSubmission" },
      "description": "Pendaftaran produk anggota yang menunggu peninjauan admin."
    },
    "/newsArticles/{articleId}": {
      "schema": { "$ref": "#/entities/NewsArticle" },
      "description": "Berita, pengumuman, dan artikel kegiatan koperasi."
    },
    "/newsComments/{commentId}": {
      "schema": { "$ref": "#/entities/NewsComment" },
      "description": "Komentar pengunjung dan balasan pengurus pada artikel berita."
    },
    "/galleryItems/{itemId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Dokumentasi foto dan video kegiatan koperasi."
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Testimoni anggota koperasi."
    },
    "/joinInquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/JoinInquiry" },
      "description": "Formulir minat menjadi anggota (hanya dapat dibaca admin)."
    },
    "/contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Pesan kontak masuk dari pengunjung (hanya dapat dibaca admin)."
    },
    "/visitLogs/{logId}": {
      "schema": { "$ref": "#/entities/VisitLog" },
      "description": "Catatan kunjungan halaman untuk statistik dashboard admin."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Registri administrator koperasi."
    }
  }
}
